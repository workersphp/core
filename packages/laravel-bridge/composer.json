{
    "name": "workersphp/laravel-bridge",
    "description": "Cloudflare-native Laravel drivers for Workers PHP: D1 database, KV and Durable Object caches, R2 storage, Queues, broadcasting and mail.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/mail": "^11.0|^12.0|^13.0",
        "league/flysystem": "^3.0",
        "symfony/mailer": "^7.0||^8.0",
        "symfony/mime": "^7.0||^8.0",
        "symfony/http-kernel": "^7.0||^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "WorkersPhp\\Cloudflare\\": "src/"
        },
        "files": [
            "src/polyfill/fileinfo.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "WorkersPhp\\Cloudflare\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "WorkersPhp\\Cloudflare\\CloudflareServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "archive": {
        "exclude": ["/vendor", "/composer.lock", "/tests", "/phpunit.xml"]
    },
    "minimum-stability": "stable"
}
