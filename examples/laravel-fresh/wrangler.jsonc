{
  // Account comes from `wrangler login` or the CLOUDFLARE_ACCOUNT_ID env var.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "php-laravel-fresh",
  "main": "src/index.mjs",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
