{
	// Account comes from `wrangler login` or the CLOUDFLARE_ACCOUNT_ID env var.
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "php-clock-probe",
	"main": "src/index.js",
	"compatibility_date": "2026-08-01",
	"limits": { "cpu_ms": 15000 },
	"observability": { "enabled": true }
}
